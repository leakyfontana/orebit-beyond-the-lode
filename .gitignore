# Local/private intake is not part of the public game repository.
/automation/*
!/automation/release/
!/automation/announcements/
!/automation/coop/
!/automation/ops/
!/automation/vps/
!/automation/pvp_bots/
/automation/pvp_bots/*
!/automation/pvp_bots/supervisor.py
!/automation/pvp_bots/worker.gd
!/automation/pvp_bots/policy.gd
!/automation/pvp_bots/pool.json
!/automation/pvp_bots/package.py
!/automation/pvp_bots/orebit-pvp-bots.service
/automation/vps/*
!/automation/vps/orebit-ops.service
!/automation/vps/orebit-ops.timer

# Verification toolchains, captures and source-reference downloads stay local.
/verification/*
!/verification/build_web.py
!/verification/bake_capture_build.py
!/verification/box2d_build.json
!/verification/box2d-godot-4.7.2.patch
!/verification/box2d-fixture-shape-sync.patch
!/verification/godot-cpp-msvc-conformance.patch
!/verification/coop_state_interop.gd
!/verification/coop_surface_interop.gd
!/verification/fuel_pricing_interop.gd
!/verification/generate_sinclair_station.py
!/verification/coop_input_interop.gd
!/verification/spawn_impact_interop.gd
!/verification/close_target_interop.gd
!/verification/lobby_controller_interop.gd

# Built artifacts and per-machine credentials are never source inputs.
/dist/
/godot/addons/godot-box2d/bin/
/godot/data/unity_manifest.json
*.keystore
*.jks
*.pem
*.key
.env
.env.*
__pycache__/
*.pyc
.DS_Store

# Gameplay archives are private runtime data, not source.
/captures/
/automation/coop/captures/
