[configuration]
entry_symbol = "physics_server_box2d_library_init"
compatibility_minimum = "4.7"

[libraries]
macos.debug.arm64 = "res://addons/godot-box2d/bin/libgodot-box2d.macos.template_release.framework"
macos.release.arm64 = "res://addons/godot-box2d/bin/libgodot-box2d.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/godot-box2d/bin/libgodot-box2d.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/godot-box2d/bin/libgodot-box2d.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/godot-box2d/bin/libgodot-box2d.android.template_release.arm64.so"
android.release.arm64 = "res://addons/godot-box2d/bin/libgodot-box2d.android.template_release.arm64.so"
web.debug.wasm32 = "res://addons/godot-box2d/bin/libgodot-box2d.web.template_release.wasm32.nothreads.wasm"
web.release.wasm32 = "res://addons/godot-box2d/bin/libgodot-box2d.web.template_release.wasm32.nothreads.wasm"
