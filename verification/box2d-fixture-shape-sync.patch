+void b2Fixture::SynchronizeShape()
+{
+	if (m_body == nullptr || m_proxyCount == 0)
+	{
+		return;
+	}
+
+	b2World* world = m_body->GetWorld();
+	b2Assert(world->IsLocked() == false);
+	if (world->IsLocked())
+	{
+		return;
+	}
+
+	// Keep the vendor m_newContacts flag/layout: this first-party boundary
+	// publishes contact discovery only after every edited proxy is synchronized.
+	enum class ShapeSyncState { RefreshProxies, RequestContacts, Complete };
+	ShapeSyncState state = ShapeSyncState::RefreshProxies;
+	while (state != ShapeSyncState::Complete)
+	{
+		switch (state)
+		{
+		case ShapeSyncState::RefreshProxies:
+		{
+			b2BroadPhase* broadPhase = &world->m_contactManager.m_broadPhase;
+			const b2Transform& transform = m_body->GetTransform();
+			for (int32 i = 0; i < m_proxyCount; ++i)
+			{
+				b2FixtureProxy* proxy = m_proxies + i;
+				m_shape->ComputeAABB(&proxy->aabb, transform, proxy->childIndex);
+				broadPhase->MoveProxy(proxy->proxyId, proxy->aabb, b2Vec2_zero);
+			}
+			state = ShapeSyncState::RequestContacts;
+			break;
+		}
+		case ShapeSyncState::RequestContacts:
+			world->m_newContacts = true;
+			state = ShapeSyncState::Complete;
+			break;
+		case ShapeSyncState::Complete:
+			break;
+		}
+	}
+}
