+void Box2DSpace2D::notify_shape_contacts(Box2DCollisionObject2D *p_object, uint32_t p_first_shape, bool p_started) {
+	for (b2ContactEdge *edge = p_object->get_body_handle()->GetContactList(); edge; edge = edge->next) {
+		b2Contact *contact = edge->contact;
+		if (!contact->IsTouching()) {
+			continue;
+		}
+		b2Fixture *fixture = contact->GetFixtureA();
+		if (fixture->GetBody() != p_object->get_body_handle()) {
+			fixture = contact->GetFixtureB();
+		}
+		if (fixture->GetUserData().shape_idx < p_first_shape) {
+			continue;
+		}
+		box2d::CollisionEventInfo event_info = event_info_from_contact(contact);
+		if (!event_info.is_valid) {
+			continue;
+		}
+		event_info.is_started = p_started;
+		collision_event_callback(&event_info);
+	}
 }
