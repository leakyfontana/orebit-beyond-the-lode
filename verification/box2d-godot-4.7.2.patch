+void Box2DArea2D::_reset_monitoring(Type p_type) {
+	// Pending notifications belong to the previous observer, not its replacement.
+	for (auto entry = monitored_objects.begin(); entry;) {
+		auto next = entry;
+		++next;
+		if (entry->value.type == p_type) {
+			monitored_objects.remove(entry);
+		}
+		entry = next;
+	}
+	if (get_space()) {
+		for (auto entry = monitored_contacts.begin(); entry; ++entry) {
+			Box2DCollisionObject2D *object = nullptr;
+			bool enabled = false;
+			if (p_type == Type::TYPE_BODY) {
+				object = get_space()->get_body_from_rid(entry->key.rid);
+				enabled = !monitor_callback.is_null();
+			} else {
+				Box2DArea2D *area = get_space()->get_area_from_rid(entry->key.rid);
+				object = area;
+				enabled = !area_monitor_callback.is_null() && area && area->is_monitorable();
+			}
+			if (!object) {
+				continue; // This contact belongs to the other monitor category.
+			}
+			entry->value.monitoring = enabled;
+			if (enabled) {
+				_queue_monitor(entry->key, object, 1);
+			}
+		}
+	}
+	if (monitored_objects.is_empty()) {
+		monitor_query_list.remove_from_list();
+	}
